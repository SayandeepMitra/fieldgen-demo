    },
    "reads_reference_data": {
     "type": "boolean"
    },
    "depth_of_overlap": {
     "type": "string"
    }
   },
   "required": [
    "include_target_samples",
    "reads_answer_key",
    "reads_reference_data",
    "depth_of_overlap"
   ],
   "additionalProperties": false
  },
  "caps": {
   "type": "object"
  },
  "counts": {
   "type": "object"
  },
  "content_hashes": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
   }
  },
  "input_hashes": {
   "type": "object"
  }
 },
 "required": [
  "version",
  "package",
  "seed",
  "build_parameters",
  "caps",
  "counts",
  "content_hashes",
  "input_hashes"
 ],
 "additionalProperties": false,
