{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Matches for one setting",
 "type": "object",
 "propertyNames": {
  "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
 },
 "additionalProperties": {
  "type": "array",
  "items": {
   "type": "object",
   "required": [
    "relation",
    "column"
   ],
   "additionalProperties": false,
   "properties": {
    "relation": {
     "type": "string"
    },
    "column": {
     "type": "string"
    }
   }
  }
 }
}