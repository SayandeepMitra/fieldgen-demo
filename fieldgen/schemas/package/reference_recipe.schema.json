{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Gold recipe (harness side)",
 "type": "object",
 "required": [
  "table",
  "grain",
  "combine",
  "group_by",
  "branches",
  "table_roles"
 ],
 "additionalProperties": false,
 "properties": {
  "table": {
   "type": "string"
  },
  "grain": {
   "type": "string"
  },
  "combine": {
   "enum": [
    "none",
    "union_distinct",
    "union_all"
   ]
  },
  "group_by": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    }
   ]
  },
  "branches": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "from"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "from": {
      "type": "string"
     }
    }
   }
  },
  "table_roles": {
   "type": "object",
   "additionalProperties": {
    "enum": [
     "driver",
     "lookup",
     "filter"
    ]
   }
  },
  "keys": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "column",
     "order_by"
    ],
    "additionalProperties": false,
    "properties": {
     "column": {
      "type": "string",
      "minLength": 1
     },
     "order_by": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "minLength": 1
      }
     }
    }
   }
  },
  "passthrough": {
   "type": "boolean"
  },
  "note": {
   "type": "string"
  }
 }
}