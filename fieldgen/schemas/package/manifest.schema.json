{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Package manifest",
 "type": "object",
 "required": [
  "name",
  "version",
  "source_row_counts",
  "target_tables"
 ],
 "additionalProperties": true,
 "properties": {
  "name": {
   "type": "string"
  },
  "version": {
   "type": "string"
  },
  "source_row_counts": {
   "type": "object",
   "additionalProperties": {
    "type": "integer",
    "minimum": 0
   }
  },
  "target_tables": {
   "type": "integer",
   "minimum": 1
  }
 }
}