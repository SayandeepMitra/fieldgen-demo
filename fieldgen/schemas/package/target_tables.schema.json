{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Target tables",
 "type": "array",
 "minItems": 1,
 "items": {
  "type": "object",
  "required": [
   "name",
   "columns",
   "pk",
   "fks",
   "business_ids"
  ],
  "properties": {
   "name": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "columns": {
    "type": "array",
    "minItems": 1,
    "items": {
     "type": "object",
     "required": [
      "name",
      "type",
      "nullable",
      "constraints"
     ],
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1
      },
      "type": {
       "type": "string"
      },
      "nullable": {
       "type": "boolean"
      },
      "description": {
       "type": "string"
      },
      "constraints": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "value_hints": {
       "type": "object",
       "required": [
        "format"
       ],
       "properties": {
        "format": {
         "type": "string"
        }
       }
      }
     }
    }
   },
   "pk": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "business_ids": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "fks": {
    "type": "array",
    "items": {
     "type": "object",
     "required": [
      "columns",
      "ref_table",
      "ref_columns"
     ],
     "properties": {
      "columns": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "minItems": 1
      },
      "ref_table": {
       "type": "string"
      },
      "ref_columns": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "minItems": 1
      }
     }
    }
   }
  }
 }
}