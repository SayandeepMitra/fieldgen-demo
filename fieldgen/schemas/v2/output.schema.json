{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Model output for one target field",
  "type": "object",
  "required": ["task_id", "status", "assumptions"],
  "additionalProperties": false,
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["answer", "ambiguous"]},
    "expressions": {"$ref": "#/definitions/expressions"},
    "uses": {"type": "array", "items": {"type": "string"}},
    "class": {"enum": ["copy_or_rename", "retype", "conditional", "window_keygen", "aggregate", "hash",
                       "concat", "string_func", "date_extract", "multi_source_expr", "constant",
                       "null_placeholder", "other"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "candidates": {
      "type": "array", "minItems": 2, "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["expressions", "rationale"],
        "additionalProperties": false,
        "properties": {
          "expressions": {"$ref": "#/definitions/expressions"},
          "rationale": {"type": "string"}
        }
      }
    },
    "default": {"type": "integer", "minimum": 0, "maximum": 2},
    "needed": {"type": "string", "minLength": 1}
  },
  "definitions": {
    "expressions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["branch", "sql"],
        "additionalProperties": false,
        "properties": {
          "branch": {"type": "string", "minLength": 1},
          "sql": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "answer"}}},
     "then": {"required": ["expressions", "uses", "class"]}},
    {"if": {"properties": {"status": {"const": "ambiguous"}}},
     "then": {"required": ["candidates", "default", "needed"]}}
  ]
}
