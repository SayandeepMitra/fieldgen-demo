{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Step 1 output: the recipe for one target table",
 "type": "object",
 "required": [
  "task_id",
  "step",
  "grain",
  "branches",
  "combine",
  "group_by",
  "decisions",
  "assumptions"
 ],
 "additionalProperties": false,
 "properties": {
  "task_id": {
   "type": "string",
   "minLength": 1
  },
  "step": {
   "const": "recipe"
  },
  "grain": {
   "type": "string",
   "minLength": 1
  },
  "branches": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "from"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "from": {
      "type": "string",
      "pattern": "^\\s*FROM\\s"
     }
    }
   }
  },
  "combine": {
   "enum": [
    "none",
    "union_distinct",
    "union_all"
   ]
  },
  "group_by": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1
     }
    }
   ]
  },
  "decisions": {
   "type": "object",
   "required": [
    "joins",
    "stacked",
    "deduplicated",
    "aggregated"
   ],
   "additionalProperties": false,
   "properties": {
    "joins": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "stacked": {
     "type": "boolean"
    },
    "deduplicated": {
     "type": "boolean"
    },
    "aggregated": {
     "type": "boolean"
    }
   }
  },
  "assumptions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "keys": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "column",
     "order_by"
    ],
    "additionalProperties": false,
    "properties": {
     "column": {
      "type": "string",
      "minLength": 1
     },
     "order_by": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "minLength": 1
      }
     }
    }
   }
  }
 }
}